# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Postmark (email)
POSTMARK_API_KEY=
POSTMARK_FROM_EMAIL=noreply@ziva.marketing

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Figma OAuth (brand style-guide analysis from a Figma file)
# Create an app at https://www.figma.com/developers/apps and add the redirect
# URL <APP_URL>/api/figma/oauth/callback to its allowed callbacks.
FIGMA_OAUTH_CLIENT_ID=
FIGMA_OAUTH_CLIENT_SECRET=
# Optional — defaults to <request origin>/api/figma/oauth/callback
FIGMA_OAUTH_REDIRECT_URI=
# Optional — defaults to "file_content:read". Must match a granular scope
# enabled on the app's OAuth scopes page (files:read/file_read are removed).
FIGMA_OAUTH_SCOPE=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=your-session-secret-at-least-32-chars

# Marker.io (frontend bug tracker — get project ID from marker.io dashboard)
NEXT_PUBLIC_MARKERIO_PROJECT_ID=
